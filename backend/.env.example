# Local:   DATABASE_ADMIN_URL="postgresql://user:password@localhost:5432/pelvi_admin"
# Supabase (Transaction Pooler, porta 6543 — app runtime):
#   DATABASE_ADMIN_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_ADMIN_URL="postgresql://user:password@host:5432/pelvi_admin"

# Supabase (conexão direta, porta 5432 — Prisma migrations only):
#   DIRECT_DATABASE_ADMIN_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_DATABASE_ADMIN_URL=
JWT_ADMIN_SECRET="your-strong-secret-here"
JWT_ADMIN_REFRESH_SECRET="another-strong-secret-distinct-from-the-access-secret"
PORT=3001
CORS_ORIGIN="https://your-admin-frontend-url.com"
NODE_ENV="production"
CLINIC_API_URL="https://api.soupelvi.com.br"
# CLINIC_INTERNAL_API_KEY — shared secret used in x-internal-api-key header for machine-to-machine calls.
# Rotation policy: rotate every 90 days or immediately upon suspected compromise.
# Steps: generate a new high-entropy secret (min 32 chars), update both services simultaneously,
# verify connectivity, then revoke the old key.
# Future: replace with short-lived JWT (machine-to-machine) to eliminate the need for manual rotation.
CLINIC_INTERNAL_API_KEY="your-strong-shared-secret-min-32-chars"
# CLINIC_EXTERNAL_API_KEY — secret accepted on x-clinic-api-key header from pelvi-ui backend
# (clinic→admin channel). Must match ADMIN_EXTERNAL_API_KEY in pelvi-ui.
# Same rotation policy as CLINIC_INTERNAL_API_KEY (90 days).
CLINIC_EXTERNAL_API_KEY="your-strong-shared-secret-min-32-chars"
# RESEND_API_KEY — Resend API credential used to send the onboarding welcome email.
# Required in every environment (including local dev) — app fails to start without it.
RESEND_API_KEY="re_your_api_key"
# MAIL_FROM — sender identity for onboarding emails, e.g. "Pelvi <bemvindo@soupelvi.com.br>".
# Domain must be verified in Resend (SPF/DKIM) or mail lands in spam.
MAIL_FROM="Pelvi <bemvindo@soupelvi.com.br>"
# CLINIC_APP_URL — base URL of the pelvi-ui frontend (distinct from CLINIC_API_URL,
# which is the API). Used to build the login link in the onboarding welcome email.
# Required in every environment — app fails to start without it.
CLINIC_APP_URL="https://app.soupelvi.com.br"
